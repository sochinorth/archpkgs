# Maintainer: Your Name <ed2092000 at gmail dot com>
#
# Upstream publishes the server and its controller as two crates with their
# own version numbers. pkgver follows kak-tree-sitter; _ktsctlver tracks
# ktsctl, and a ktsctl-only release bumps pkgrel (see update.sh).

pkgname=kak-tree-sitter
pkgver=3.2.2
_ktsctlver=3.1.4
pkgrel=3
pkgdesc="Server between Kakoune and tree-sitter, with the ktsctl grammar and query manager"
arch=('x86_64')
url="https://sr.ht/~hadronized/kak-tree-sitter/"
license=('BSD-3-Clause')
depends=('gcc-libs' 'glibc' 'git')
makedepends=('rust')
optdepends=('kakoune: the editor this serves'
						'gcc: ktsctl compiling grammars (any C compiler providing cc works)')
provides=("ktsctl=$_ktsctlver")
conflicts=('ktsctl')
replaces=('ktsctl')
options=('!lto')
source=("kak-tree-sitter-$pkgver.tar.gz::https://static.crates.io/crates/kak-tree-sitter/kak-tree-sitter-$pkgver.crate"
				"ktsctl-$_ktsctlver.tar.gz::https://static.crates.io/crates/ktsctl/ktsctl-$_ktsctlver.crate"
				"01-nav-position.patch"
				"02-drop-closed-conn.patch"
				"03-node-end-column.patch"
				"04-session-reinit.patch")
sha256sums=('4fd03b16309a759558974ac88ddafb764ab314154349c4891eea27a70823c052'
						'a87f1d7ac18d22d9bd0b24080b3722a4d1f2976e7734027e0df382908248bbd6'
						'c360247d80340b11b386fc756cee58d6db196ba9ac7060d07f464392317aec36'
						'2d64a23b0a154c107128e949aa2941ed8c54624b66a744771968c03a2b4450a3'
						'bc8b8069f447ed85575ffb8079773969db8ac9c3bb37483fa32a252187357a42'
						'12625cc39eb8a4b97870503514919b66edd2c921ebc0f2509973b68ad4aceb36')

_crates=("kak-tree-sitter-$pkgver" "ktsctl-$_ktsctlver")

prepare() {
	# The patches in source=, applied in order. All are unfixed upstream as of
	# 3.2.2; drop one once a release fixes it (it then fails to apply, and CI
	# keeps the previous build).
	#
	# 01-nav-position: tree navigation (tree-sitter-nav: parent, children,
	# siblings) started one line and one column past the selection:
	# Pos::into_tree_sitter took Kakoune's 1-based positions as 0-based.
	#
	# 02-drop-closed-conn: the server never dropped a client's connection once
	# it had read its request, so a later event on it (the client closing after
	# shutting down writing, say) had the same request processed again, its
	# answer coming late: a quick repeat of tree-sitter-nav '"parent"' could be
	# undone by the first one's second answer. Every request also leaked a file
	# descriptor in the server.
	#
	# 03-node-end-column: selections ending with a node that ends with a newline
	# (the root node, a C #include line) came back with column 0, which select
	# rejects: the node's end was taken as its exclusive end minus one column,
	# the start of the next line. Now it's the node's last character. (Text
	# objects in select mode also ended a character past the node.)
	#
	# 04-session-reinit: a session that went away without telling the server
	# (killed, or quit before the server's init answer installed its KakEnd
	# hook) stayed tracked, and a later session of the same name got no
	# tree-sitter at all. A repeated session_begin now initializes the session
	# again, from a clean slate as tree-sitter-reload does.
	local src
	for src in "${source[@]}"; do
		[[ $src == *.patch ]] || continue
		patch -d "kak-tree-sitter-$pkgver" -Np1 -i "$srcdir/$src"
	done

	export RUSTUP_TOOLCHAIN=stable
	local target crate
	target=$(rustc -vV | sed -n 's/host: //p')
	for crate in "${_crates[@]}"; do
		(cd "$crate" && cargo fetch --locked --target "$target")
	done
}

build() {
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	local crate
	for crate in "${_crates[@]}"; do
		(cd "$crate" && cargo build --frozen --release)
	done
}

package() {
	install -Dm755 "kak-tree-sitter-$pkgver/target/release/kak-tree-sitter" -t "$pkgdir/usr/bin"
	install -Dm755 "ktsctl-$_ktsctlver/target/release/ktsctl" -t "$pkgdir/usr/bin"
	install -Dm644 "kak-tree-sitter-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm644 "kak-tree-sitter-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 "ktsctl-$_ktsctlver/README.md" "$pkgdir/usr/share/doc/$pkgname/README-ktsctl.md"
}
