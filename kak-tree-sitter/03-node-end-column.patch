+  /// Position of the last character of a node: the (inclusive) end of a Kakoune selection of that node.
+  ///
+  /// Tree-sitter’s end byte is exclusive. Its position minus one column is wrong when the node ends with a newline (the
+  /// root node, a C `#include` line, …): the end byte is then at the start of the next line — past the end of the
+  /// buffer, for the root node — and the column comes out as 0, which Kakoune rejects. Take the character before the
+  /// end byte instead; this also lands on the first byte of a multi-byte character, as Kakoune expects.
+  pub fn node_end(buf: RopeSlice, node: &Node) -> Self {
+    let (start, end) = (node.start_byte() as usize, node.end_byte() as usize);
+    let last = if end > start {
+      buf.char_to_byte(buf.byte_to_char(end - 1))
+    } else {
+      start // empty node
+    };
+
+    Self::from_tree_sitter(buf, last as _)
+  }
+
